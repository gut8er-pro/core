# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database
DATABASE_URL=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Anthropic (AI features)
ANTHROPIC_API_KEY=

# Resend (email)
# RESEND_SENDING_DOMAIN is a bare domain, verified in Resend. Both mail streams
# leave from it — gutachten@<domain> and noreply@<domain> — and the local parts
# are not settings. In production: gut8erpro.de
RESEND_API_KEY=
RESEND_SENDING_DOMAIN=

# Sentry (optional — leave unset to disable. Set SENTRY_AUTH_TOKEN to also
# upload source maps during the build.)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# App — the dashboard (app.gut8erpro.de in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Marketing site — the Astro landing + legal pages (gut8erpro.de in production)
NEXT_PUBLIC_MARKETING_URL=http://localhost:4321
